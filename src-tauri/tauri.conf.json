{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipFetch",
  "version": "1.0.0",
  "identifier": "app.clipfetch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipFetch",
        "width": 1280,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/preview/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ClipFetch",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Descarga video y audio con yt-dlp",
    "longDescription": "ClipFetch es una interfaz sencilla para yt-dlp. Descarga video y audio de YouTube y otros sitios compatibles.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
